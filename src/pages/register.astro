---
import Base from '../layouts/Base.astro';
---
<Base title="Daftar Host — umpomenfess room" noindex>
  <section class="narrow auth">
    <p class="eyebrow">akun Host</p>
    <h1>Daftar</h1>
    <p class="auth__sub">
      Akun Host dipakai untuk membuat room dan memegang moderasi.
      Satu akun bisa memegang 3 room aktif pada tier Free.
    </p>

    <form class="glass-card auth__card" method="post" action="/register" novalidate>
      <div class="field">
        <label for="email">Email</label>
        <input class="input" type="email" id="email" name="email" autocomplete="email" required />
        <p class="help">Hanya email institusi atau pribadimu — tidak ditampilkan ke Guest.</p>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input class="input" type="password" id="password" name="password" autocomplete="new-password" minlength="8" required />
        <p class="help"><strong>Minimal 8 karakter.</strong> Ini password akun, berbeda dari password room.</p>
      </div>
      <div class="turnstile-ph" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.4-3 8.4-7 9.6-4-1.2-7-5.2-7-9.6V6z"/><path d="M9.5 12l1.8 1.8L15 10"/></svg>
        Widget Turnstile — placeholder (T-50)
      </div>
      <button class="btn btn--primary btn--block" type="submit" disabled>Daftar</button>
      <p class="help">
        Setelah daftar, kami kirim email konfirmasi. Tombol diaktifkan
        setelah Turnstile terpasang pada T-50.
      </p>
    </form>

    <p class="auth__alt">
      Sudah punya akun? <a href="/login">Masuk</a>
    </p>
  </section>
</Base>

<style>
  .auth { padding-top: var(--space-5); }
  .auth h1 { font-size: var(--step-3); margin-bottom: var(--space-2); }
  .auth__sub { color: var(--ink-soft); margin: 0 0 var(--space-5); }
  .auth__card { display: flex; flex-direction: column; gap: var(--space-3); max-width: 460px; }
  .auth__card .field { margin-bottom: 0; }
  .auth__alt { margin-top: var(--space-5); font-size: 0.875rem; color: var(--text-muted); }
</style>
