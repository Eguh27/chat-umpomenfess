---
/* Stiker dekoratif — SVG 1:1 dari DNA template "stiker" situs utama
   (umpomenfess/src/lib/templates/render.ts). Aria-hidden + pointer-events
   none agar tidak pernah mengganggu interaksi. Posisi/ukuran diatur lewat
   `style` dari pemanggil (absolute). */
interface Props {
  variant: 'chat' | 'envelope' | 'photo' | 'spark';
  style?: string;
}
const { variant, style } = Astro.props;

const VIEWS: Record<Props['variant'], { vb: string; inner: string }> = {
  chat: {
    vb: '0 0 60 56',
    inner:
      '<rect x="2" y="2" width="56" height="38" rx="12" fill="#F5A54B" stroke="#FFF6EA" stroke-width="3"/><path d="M17 39 L17 51 L30 39" fill="#F5A54B" stroke="#FFF6EA" stroke-width="3" stroke-linejoin="round"/><path d="M30 16 c-5.5-5-13 1.5-5.5 8 l5.5 4.6 5.5-4.6 c7.5-6.5 0-13-5.5-8z" fill="#FFF6EA"/>',
  },
  envelope: {
    vb: '0 0 64 52',
    inner:
      '<rect x="2" y="4" width="60" height="44" rx="9" fill="#E8604C" stroke="#FFF6EA" stroke-width="3.5"/><path d="M6 11 L32 30 L58 11" fill="none" stroke="#FFF6EA" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  photo: {
    vb: '0 0 70 62',
    inner:
      '<rect x="2" y="2" width="66" height="58" rx="10" fill="#FBF3E4" stroke="#EADDC1" stroke-width="3"/><circle cx="23" cy="20" r="7" fill="#F6C96B"/><path d="M9 45 L27 28 L38 39 L48 31 L61 45" fill="none" stroke="#3D8A7C" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  spark: {
    vb: '0 0 44 44',
    inner:
      '<path d="M22 0 L27 17 L44 22 L27 27 L22 44 L17 27 L0 22 L17 17 Z" fill="#F6C96B" stroke="#FFFDF4" stroke-width="2.4" paint-order="stroke"/>',
  },
};
const view = VIEWS[variant];
---
<span
  class="stk"
  style={style}
  aria-hidden="true"
>
  <svg viewBox={view.vb} fill="none" set:html={view.inner} />
</span>

<style>
  .stk {
    display: block;
    pointer-events: none;
  }
  .stk svg {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 4px 10px rgba(31, 77, 70, 0.16));
  }
</style>
