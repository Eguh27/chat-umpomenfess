---
import '../../design/tokens.css';
import '../../design/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Halaman room/chat: chrome kecil, tanpa nav & footer. */
  bare?: boolean;
}
const { title, description, noindex = false, bare = false } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#DFF2EC" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23E8604C'/%3E%3Crect x='5' y='9' width='22' height='16' rx='5' fill='none' stroke='%23FFF6EA' stroke-width='2'/%3E%3Cpath d='M7 12l9 6.5L25 12' fill='none' stroke='%23FFF6EA' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3Ccircle cx='26' cy='6' r='3.2' fill='%23F6C96B'/%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700&family=Quicksand:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Lompat ke konten</a>
    <SiteHeader compact={bare}>
      <slot name="head-actions" />
    </SiteHeader>
    <main id="main" class:list={['main-shell', { 'main-shell--bare': bare }]}>
      <slot />
    </main>
    {!bare && <SiteFooter />}

    <style is:global>
      .main-shell {
        width: 100%;
        max-width: var(--container);
        margin-inline: auto;
        padding: var(--space-6) var(--space-4) var(--space-8);
      }
      .main-shell--bare {
        max-width: 880px;
        padding: var(--space-4) var(--space-3) var(--space-6);
      }
    </style>
  </body>
</html>
